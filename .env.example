# Copy to .env (docker compose reads it) and edit. Every key is optional.

# Port the web app listens on.
PORT=8080

# A local Ollama server for freshly improvised cat monologues. Leave empty to
# use the built-in lines. Example: http://your-ollama-host.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# Largest recording the API accepts, in megabytes. 60 s of 16 kHz mono WAV
# is about 2 MB.
MAX_UPLOAD_MB=8

# Requests per minute per client to the synthesis endpoints (bursts allowed up
# to the same number). Over it the API answers 429. 0 turns the limit off.
RATE_LIMIT_PER_MIN=30

# true only behind a reverse proxy you run that sets X-Forwarded-For; the
# limit then keys on the address your proxy saw.
TRUST_PROXY_HEADERS=false

# Syntheses one process runs at once, and how long (seconds) a request waits
# for a free slot before it gets 503. 0 means no cap.
MAX_CONCURRENT_RENDERS=4
RENDER_WAIT_S=5

LOG_LEVEL=INFO
