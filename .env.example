# Copy to .env (docker compose reads it) and edit. Every key is optional.

# Port the web app listens on.
PORT=8080

# A local Ollama server for freshly improvised cat monologues. Leave empty to
# use the built-in lines. Example: http://your-ollama-host.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# Largest recording the API accepts, in megabytes. 60 s of 16 kHz mono WAV
# is about 2 MB.
MAX_UPLOAD_MB=8

LOG_LEVEL=INFO
